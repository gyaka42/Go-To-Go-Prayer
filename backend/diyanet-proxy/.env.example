# Existing Diyanet configuration
DIYANET_USERNAME=
DIYANET_PASSWORD=
DIYANET_QURAN_API_KEY=

# Faith Assistant provider. Keep GROQ_API_KEY on the backend only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=15000
GROQ_MAX_COMPLETION_TOKENS=1600

# Use a separate random secret of at least 32 characters. Do not reuse GROQ_API_KEY.
FAITH_RATE_LIMIT_SECRET=
FAITH_INSTALL_MINUTE_LIMIT=4
FAITH_INSTALL_DAILY_LIMIT=10
FAITH_IP_MINUTE_LIMIT=8
FAITH_IP_DAILY_LIMIT=60
FAITH_GLOBAL_MINUTE_LIMIT=25
FAITH_GLOBAL_DAILY_LIMIT=800

# Keep disabled until the app UI, privacy disclosure and evaluation suite are release-ready.
FAITH_ASSISTANT_ENABLED=false
