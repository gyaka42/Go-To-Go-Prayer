# Existing Diyanet configuration
DIYANET_USERNAME=
DIYANET_PASSWORD=
DIYANET_QURAN_API_KEY=

# Faith Assistant provider. Keep GROQ_API_KEY on the backend only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=15000
GROQ_MAX_COMPLETION_TOKENS=700

# Keep disabled on the public deployment until privacy and abuse controls are connected.
FAITH_ASSISTANT_ENABLED=false
